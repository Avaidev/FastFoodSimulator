<Window x:Class="FastFoodSimulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:FastFoodSimulator.Behaviors"
        xmlns:v="clr-namespace:FastFoodSimulator.Views"
        Title="Fast Food Simulator"
        Width="1100" Height="780"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Width" Value="120" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#DC2626" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Settings" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Start" Command="{Binding StartCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                </StackPanel>

                <WrapPanel IsEnabled="{Binding IsSettingsEditable}">
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="Customer Arrival Interval (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding Settings.CustomerArrivalInterval, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="Order Taking Interval (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding Settings.OrderTakingInterval, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="Order Fulfillment Interval (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding Settings.OrderFulfillmentInterval, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="Number of Order Takers" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding Settings.OrderTakerCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="Number of Cooks" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding Settings.CookCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </GroupBox>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="8"
                Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.IsValid}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Settings.WarningMessage}" Foreground="#B91C1C" TextWrapping="Wrap" />
        </Border>

        <v:VisualizerView Grid.Row="2" Margin="0,8,0,0" />

        <GroupBox Grid.Row="3" Header="Simulation Log" Margin="0,8,0,0" Padding="4">
            <ListBox ItemsSource="{Binding LogEntries}"
                     b:AutoScrollBehavior.Enabled="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
