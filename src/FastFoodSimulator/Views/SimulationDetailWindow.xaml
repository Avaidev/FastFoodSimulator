<Window x:Class="FastFoodSimulator.Views.SimulationDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FastFoodSimulator.ViewModels"
        Title="Simulation Visualizer"
        Width="1000" Height="540"
        MinWidth="700" MinHeight="400"
        Background="#F9FAFB">

    <Viewbox Margin="10" Stretch="Uniform">
        <Grid Width="960" Height="440">
            <Canvas>
                <Rectangle Canvas.Left="20" Canvas.Top="40" Width="280" Height="390"
                           Fill="#EFF6FF" Stroke="#93C5FD" StrokeThickness="2" RadiusX="8" RadiusY="8" />
                <TextBlock Canvas.Left="30" Canvas.Top="46" Text="ORDER LINE" FontWeight="Bold" FontSize="14" />
                <TextBlock Canvas.Left="30" Canvas.Top="70" Text="Customers waiting to order" Foreground="#4B5563" />
                <TextBlock Canvas.Left="30" Canvas.Top="275" Text="Order takers (current order)" Foreground="#4B5563" />

                <Rectangle Canvas.Left="340" Canvas.Top="40" Width="280" Height="390"
                           Fill="#FFFBEB" Stroke="#FCD34D" StrokeThickness="2" RadiusX="8" RadiusY="8" />
                <TextBlock Canvas.Left="350" Canvas.Top="46" Text="KITCHEN" FontWeight="Bold" FontSize="14" />
                <TextBlock Canvas.Left="350" Canvas.Top="70" Text="Carousel (waiting tickets)" Foreground="#4B5563" />
                <TextBlock Canvas.Left="350" Canvas.Top="275" Text="Cooks (preparing)" Foreground="#4B5563" />

                <Rectangle Canvas.Left="660" Canvas.Top="40" Width="280" Height="390"
                           Fill="#F0FDF4" Stroke="#86EFAC" StrokeThickness="2" RadiusX="8" RadiusY="8" />
                <TextBlock Canvas.Left="670" Canvas.Top="46" Text="PICKUP" FontWeight="Bold" FontSize="14" />
                <TextBlock Canvas.Left="670" Canvas.Top="70" Text="Serving line (customers)" Foreground="#4B5563" />
                <TextBlock Canvas.Left="670" Canvas.Top="275" Text="Counter (ready orders)" Foreground="#4B5563" />

                <TextBlock Canvas.Left="306" Canvas.Top="215" Text="➜" FontSize="26" Foreground="#9CA3AF" />
                <TextBlock Canvas.Left="626" Canvas.Top="215" Text="➜" FontSize="26" Foreground="#9CA3AF" />

                <Ellipse Canvas.Left="20" Canvas.Top="8" Width="14" Height="14" Fill="#93C5FD" Stroke="#374151" />
                <TextBlock Canvas.Left="40" Canvas.Top="7" Text="Customer (C#)" />
                <Rectangle Canvas.Left="150" Canvas.Top="8" Width="14" Height="14" Fill="#FDE68A" Stroke="#374151" />
                <TextBlock Canvas.Left="170" Canvas.Top="7" Text="Ticket / order (#)" />
            </Canvas>

            <ItemsControl ItemsSource="{Binding Tokens}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:CircleToken}">
                        <Grid Width="32" Height="32">
                            <Ellipse Fill="{Binding Fill}" Stroke="#374151" StrokeThickness="1.5" />
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SquareToken}">
                        <Grid Width="32" Height="32">
                            <Rectangle Fill="{Binding Fill}" Stroke="#374151" StrokeThickness="1.5" RadiusX="4" RadiusY="4" />
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </Grid>
    </Viewbox>
</Window>
