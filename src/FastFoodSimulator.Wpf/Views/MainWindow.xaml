<Window x:Class="FastFoodSimulator.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastFoodSimulator.Wpf.Views"
        Title="Fast Food Simulator — Pro Edition"
        Width="1230" Height="866"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Input area + Start / Stop ============ -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🍔" FontFamily="Segoe UI Emoji" FontSize="24"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <TextBlock Text="Интервал прихода (мс):" Style="{StaticResource FieldLabel}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Style="{StaticResource InputBox}" Width="88"
                         Text="{Binding ArrivalIntervalText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotRunning}" />

                <TextBlock Text="Интервал готовки (мс):" Style="{StaticResource FieldLabel}"
                           FontSize="14" VerticalAlignment="Center" Margin="26,0,8,0" />
                <TextBox Style="{StaticResource InputBox}" Width="88"
                         Text="{Binding CookingIntervalText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotRunning}" />

                <Button Style="{StaticResource PrimaryButton}" Content="▶  Запустить"
                        Command="{Binding StartCommand}" Margin="26,0,0,0" />
                <Button Style="{StaticResource DangerButton}" Content="■  Стоп"
                        Command="{Binding StopCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ Customised warning for wrong input ============ -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10"
                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontFamily="Segoe UI Emoji" FontSize="16"
                           Foreground="#B91C1C" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding WarningMessage}" Foreground="#B91C1C" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ Four status cards ============ -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="-6,16,-6,0">

            <!-- 1. Order line -->
            <HeaderedContentControl Header="1. Очередь заказа" Style="{StaticResource StageCard}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Клиентов в очереди:" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource ValueBox}" Text="{Binding CustomersInLine, Mode=OneWay}" />
                </StackPanel>
            </HeaderedContentControl>

            <!-- 2. Cash desk -->
            <HeaderedContentControl Header="2. Касса" Style="{StaticResource StageCard}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Обслуживается заказ №:" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource ValueBox}"
                             Background="{StaticResource CashTintBrush}"
                             BorderBrush="{StaticResource CashBorderBrush}"
                             Foreground="{StaticResource CashTextBrush}"
                             Text="{Binding OrderBeingTaken, Mode=OneWay}" />
                </StackPanel>
            </HeaderedContentControl>

            <!-- 3. Kitchen -->
            <HeaderedContentControl Header="3. Кухня" Style="{StaticResource StageCard}" Margin="6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Готовится №:" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource ValueBox}"
                             Background="{StaticResource KitchenTintBrush}"
                             BorderBrush="{StaticResource KitchenBorderBrush}"
                             Foreground="{StaticResource KitchenTextBrush}"
                             Text="{Binding OrderBeingCooked, Mode=OneWay}" />

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="В очереди:" Style="{StaticResource FieldLabel}"
                               Margin="10,0,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueBox}" Width="50"
                             Margin="10,4,0,0" HorizontalContentAlignment="Center"
                             Text="{Binding KitchenQueueCount, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Ожидают на кухне:"
                               Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ValueBox}"
                             FontWeight="Normal" TextWrapping="Wrap" MinHeight="44" MaxHeight="76"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Text="{Binding KitchenQueueText, Mode=OneWay}" />
                </Grid>
            </HeaderedContentControl>

            <!-- 4. Pickup -->
            <HeaderedContentControl Header="4. Выдача" Style="{StaticResource StageCard}" Margin="6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Готов к выдаче №:" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource ValueBox}"
                             Background="{StaticResource PickupTintBrush}"
                             BorderBrush="{StaticResource PickupBorderBrush}"
                             Foreground="{StaticResource PickupTextBrush}"
                             Text="{Binding ReadyForPickup, Mode=OneWay}" />

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Ждут линию:" Style="{StaticResource FieldLabel}"
                               Margin="10,0,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueBox}" Width="50"
                             Margin="10,4,0,0" HorizontalContentAlignment="Center"
                             Text="{Binding ServingLineCount, Mode=OneWay}" />
                </Grid>
            </HeaderedContentControl>
        </UniformGrid>

        <!-- ============ Graphical map of the flows ============ -->
        <HeaderedContentControl Grid.Row="3" Margin="0,16,0,0"
                                Header="Интерактивная карта потоков ресторана"
                                Style="{StaticResource StageCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:StageColumn Grid.Column="0" Header="Очередь клиентов" Glyph="👥"
                                   Accent="{StaticResource QueueAccentBrush}"
                                   Tint="{StaticResource QueueTintBrush}"
                                   ItemsSource="{Binding OrderLineChips}" />

                <Rectangle Grid.Column="1" Width="1" Margin="6,0" Stroke="#CBD5E1" StrokeDashArray="4 4"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <views:StageColumn Grid.Column="2" Header="Касса (Прием)" Glyph="🧾" ActiveGlyph="💳"
                                   Accent="{StaticResource CashAccentBrush}"
                                   Tint="{StaticResource CashTintBrush}"
                                   ItemsSource="{Binding CashChips}" />

                <Rectangle Grid.Column="3" Width="1" Margin="6,0" Stroke="#CBD5E1" StrokeDashArray="4 4"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <views:StageColumn Grid.Column="4" Header="Кухня" Glyph="🔥" ActiveGlyph="🍳"
                                   Accent="{StaticResource KitchenAccentBrush}"
                                   Tint="{StaticResource KitchenTintBrush}"
                                   ItemsSource="{Binding KitchenChips}" />

                <Rectangle Grid.Column="5" Width="1" Margin="6,0" Stroke="#CBD5E1" StrokeDashArray="4 4"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <views:StageColumn Grid.Column="6" Header="Выдача" Glyph="🛎" ActiveGlyph="🔔"
                                   Accent="{StaticResource PickupAccentBrush}"
                                   Tint="{StaticResource PickupTintBrush}"
                                   ItemsSource="{Binding PickupChips}" />
            </Grid>
        </HeaderedContentControl>
    </Grid>
</Window>
