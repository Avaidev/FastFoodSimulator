<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutrals -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="FocusBrush" Color="#3B82F6" />

    <!-- Actions -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

    <!-- Order line -->
    <SolidColorBrush x:Key="QueueAccentBrush" Color="#4682B4" />
    <SolidColorBrush x:Key="QueueTintBrush" Color="#F8FAFC" />

    <!-- Cash desk -->
    <SolidColorBrush x:Key="CashAccentBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="CashTintBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="CashTextBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="CashBorderBrush" Color="#FED7AA" />

    <!-- Kitchen -->
    <SolidColorBrush x:Key="KitchenAccentBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="KitchenTintBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="KitchenTextBrush" Color="#15803D" />
    <SolidColorBrush x:Key="KitchenBorderBrush" Color="#BBF7D0" />

    <!-- Pickup -->
    <SolidColorBrush x:Key="PickupAccentBrush" Color="#9333EA" />
    <SolidColorBrush x:Key="PickupTintBrush" Color="#FAF5FF" />
    <SolidColorBrush x:Key="PickupTextBrush" Color="#7E22CE" />
    <SolidColorBrush x:Key="PickupBorderBrush" Color="#E9D5FF" />

</ResourceDictionary>
